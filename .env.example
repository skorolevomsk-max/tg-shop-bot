# =========================
# Telegram-бот цифрового магазина — конфиг
# =========================

# Токен бота (@BotFather)
BOT_TOKEN=123456:ABC-YourBotTokenHere

# ID администраторов через запятую (например: 111111111,222222222)
ADMIN_IDS=111111111

# Канал/чат для логов и уведомлений (опционально). Бот должен быть админом.
# Пример: -1001234567890. Оставьте пустым/0 — логи только в stdout.
LOG_CHANNEL_ID=0

# Язык по умолчанию: ru или en
DEFAULT_LOCALE=ru

# Валюта по умолчанию для отображения цен и оплаты Telegram Payments / YooKassa.
# ISO-4217. Примеры: RUB, USD, EUR, KZT.
CURRENCY=RUB

# Путь к SQLite-базе (можно поменять на абсолютный)
DB_PATH=shop.db

# =========================
# Платёжные провайдеры — все опциональные.
# Если токен пустой, метод не будет показан пользователю на чекауте.
# =========================

# --- Telegram Payments (через @BotFather → Payments) ---
# Provider token (живой/тестовый).
TELEGRAM_PAYMENTS_TOKEN=

# --- YooKassa (https://yookassa.ru) ---
# Идентификатор магазина и секретный ключ из личного кабинета.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# URL, на который пользователь возвращается после оплаты YooKassa.
# Можно оставить ссылку на бота: https://t.me/<your_bot>
YOOKASSA_RETURN_URL=https://t.me/

# --- CryptoBot (Crypto Pay API, @CryptoBot → Crypto Pay → Create App) ---
CRYPTO_PAY_TOKEN=
# true — testnet, false — mainnet
CRYPTO_PAY_TESTNET=false
# Валюта счёта CryptoBot. Бот сам конвертирует цену в RUB → крипту.
# Поддерживаются USDT, TON, BTC, ETH и др. (см. Crypto Pay API).
CRYPTO_PAY_ASSET=USDT
