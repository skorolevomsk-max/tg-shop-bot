# Telegram Bot API token (от @BotFather)
BOT_TOKEN=123456:ABC-YourBotTokenHere

# ID админов через запятую (например: 111111111,222222222)
ADMIN_IDS=111111111

# ID канала логов/модерации (бот должен быть там админом). Пример: -1001234567890
LOG_CHANNEL_ID=-1001234567890

# CryptoBot API токен (от @CryptoBot -> Crypto Pay -> Create App).
# Оставьте пустым, чтобы отключить оплату через CryptoBot.
CRYPTO_PAY_TOKEN=

# Использовать тестнет CryptoBot (true/false). По умолчанию false (mainnet).
CRYPTO_PAY_TESTNET=false

# Путь до файла БД SQLite (по умолчанию shop.db в рабочей директории)
DB_PATH=shop.db
