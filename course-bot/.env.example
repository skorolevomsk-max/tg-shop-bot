# Telegram Bot API token (от @BotFather)
BOT_TOKEN=123456:ABC-YourBotTokenHere

# ID админов через запятую
ADMIN_IDS=111111111

# ID канала логов/модерации. Пример: -1001234567890
LOG_CHANNEL_ID=-1001234567890

# CryptoBot API токен. Пусто — метод скрыт.
CRYPTO_PAY_TOKEN=
CRYPTO_PAY_TESTNET=false

# Путь до файла БД SQLite
DB_PATH=course.db
